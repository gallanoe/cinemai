# Copy to .env and fill in. The SERVER reads this file directly.
# Note: the `env` block in claude_desktop_config.json sets vars for `mcp-remote`,
# NOT for this server — the key must live here.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional
PORT=3000
CINEMAI_DEFAULT_MODEL=google/gemini-2.5-flash-image
CINEMAI_DEFAULT_VIDEO_MODEL=bytedance/seedance-2.0-fast
CINEMAI_DATA_DIR=./data
# Where save_output writes files. Defaults to ~/Documents/Claude — Cowork's
# working directory on macOS, so saved files surface in a sandboxed agent's
# mounted workspace. Point this at whatever folder you've shared with the agent.
CINEMAI_EXPORT_DIR=
# Base URL reported for the out-of-band /media/<id> route (opening a clip in a
# browser, curl, VLC) and returned by the video://gen/<id> resource. Defaults to
# http://localhost:$PORT. The widget does NOT use this — the host's iframe CSP
# blocks that origin, so clips stream over the MCP connection instead. Set this
# only if you host the server remotely and want the URL to be reachable.
CINEMAI_PUBLIC_BASE_URL=

# --- Reachability and TLS -----------------------------------------------------
# Interface to bind. Defaults to loopback, so only this machine can connect.
# Node binds every interface when a host is omitted, which would put an
# unauthenticated /mcp on your local network. Set 0.0.0.0 only deliberately, and
# set CINEMAI_AUTH_TOKEN when you do.
CINEMAI_HOST=127.0.0.1

# Serve HTTPS instead of HTTP. Both must be set. Needed when a host will only
# accept an https:// connector URL (Cowork), or for any non-local deployment.
# For a locally-trusted pair:
#   brew install mkcert && mkcert -install
#   mkcert localhost 127.0.0.1 ::1
# A self-signed cert will serve TLS but clients will reject it — mkcert installs
# a local CA so the cert actually validates.
CINEMAI_TLS_KEY=
CINEMAI_TLS_CERT=

# Shared secret required on /mcp as `Authorization: Bearer <token>`. Unset means
# no check, which is fine on loopback. It is NOT optional once anything else can
# reach the port — every call spends your OpenRouter credits, so a public URL
# without this is a public spending endpoint.
#   openssl rand -hex 32
CINEMAI_AUTH_TOKEN=
